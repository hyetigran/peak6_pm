# Meridian environment template.
# Copy to `.env` (gitignored). Never commit keypairs, HMAC secrets, or funded wallets.
# Automation loads OPERATOR_KEYPAIR_PATH only. Governance / pause / override /
# upgrade keys are offline runbook inputs and must not be injected into services
# or the frontend. See docs/GOVERNANCE.md.

# --- Cluster ---
# Localnet (default for `make demo`):
RPC_URL=http://127.0.0.1:8899
WS_URL=ws://127.0.0.1:8900
# Devnet (required for `make demo-devnet` / `make oracle-e2e-devnet` when those targets exist):
# RPC_URL=https://api.devnet.solana.com
# WS_URL=wss://api.devnet.solana.com

# --- Pinned venue (do not change without a new ADR) ---
OPENBOOK_PROGRAM_ID=opnb2LAfJYbRMAHHvqjCwQxanZn7ReEHp1k81EohpZb
OPENBOOK_DEPLOYMENT_TAG=v1.7
OPENBOOK_RELEASE_COMMIT=796a470
OPENBOOK_BUILD_SHA256=a3eb0fad20778b31a20c6b98e4e61b8e9425ccbfb27a96f8165f70c0381bafa8
OPENBOOK_PROGRAMDATA_ADDRESS=DktN5HJ9uHKVRZ7FXGap4PEGVnEdc2VNBCXTt1AqJQYB

# Circle six-decimal Solana Devnet USDC. Localnet demo mints unlabeled test USD instead.
QUOTE_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# --- Program IDs ---
MERIDIAN_PROGRAM_ID=HiREMEBWNojy6KJNbMbww2YkRJEYLGMgndaKwXndK6ZD
M0_HARNESS_PROGRAM_ID=3MmdMxRUF4NWPNdwoQcLhoqfmiKReoaSQR9GwSeQEpRr
# Settlement transport: the Pyth adapter (ADR-0034). Owner of every per-ticker
# delivery PDA Meridian reads; seed/register_transport pin it as the oracle program.
ORACLE_PROGRAM_ID=Egc4ykuRJaDz7VfWS9EB9U2hsP2aU9repCCk8XGnk7w4
# Adapter identity snapshot for register_transport (ADR-0030 capture; devnet ops, ID-014):
# ORACLE_PROGRAMDATA_ADDRESS=
# ORACLE_DEPLOYMENT_SLOT=
# ORACLE_EXECUTABLE_SHA256=
# ORACLE_UPGRADE_AUTHORITY=
# Keeper oracle mode: harness (localnet mock feed) | pyth (Hermes pull -> post -> adapter crank)
# KEEPER_ORACLE=pyth
# KEEPER_PYTH_CAPTURE=at-close   # at-close (default: Hermes update AT close_ts) | latest (demo only)
# --- production keeper scheduler (#19; `make keeper-prod`, not the demo poll) ---
# KEEPER_SCHED_TICK_SECS=60      # poll cadence between scheduler ticks (MINUTES-scale in prod; job fire times drive work)
# KEEPER_LEDGER=.keeper-ledger.json   # durable run-ledger (dedupes duplicate/retried job fires across restarts)
# KEEPER_LOCK=.keeper.lock            # single-flight lock (refuses to double-run; stale after 10m)
# KEEPER_RECONCILE_SECS=120           # EventHeap reconcile + pre-open re-validation cadence (#20/#21)
# KEEPER_CORP_ACTIONS=fixtures/corporate-actions.json  # Corporate Action Blackout feed (#21, ADR-0022); prod injects two live feeds
# NYSE_CALENDAR=fixtures/nyse-calendar.json            # NYSE Trading-Day calendar (#21, ADR-0014)
# --- identity-drift monitor (#25, ADR-0030; `make identity-monitor`) ---
# Alerts route to ALERT_WEBHOOK_URL below (the #10 receiver); unset -> log only.
# MONITOR_INTERVAL_SECS=300     # how often to re-derive + compare on-chain identity
# MONITOR_TICKER=7              # which ticker's FeedVersion pins the oracle-adapter identity
# MONITOR_VERSION=1             # transport version id of that FeedVersion
# MONITOR_HASH_REQUIRED=        # true|false; default true off-localnet (localnet --bpf-program has no ProgramData to hash)

# --- Role keypairs (paths only; files live outside git) ---
# Custody, rotation, and which process may load which key: docs/GOVERNANCE.md
OPERATOR_KEYPAIR_PATH=./keys/operator.json
# GOVERNANCE_KEYPAIR_PATH=./keys/governance.json
# Seed scripts currently also accept GOVERNANCE_KEYPAIR (same meaning).
# PAUSE_AUTHORITY_KEYPAIR_PATH=./keys/pause.json
# OVERRIDE_AUTHORITY_KEYPAIR_PATH=./keys/override.json

# --- Localnet demo ---
DEMO_WALLET=
# Frontend-only public vars also live in frontend/.env.example (copy to frontend/.env.local).
NEXT_PUBLIC_INDEXER=http://127.0.0.1:8787
FE_PORT=3100
INDEXER_DB=.indexer.sqlite
PORT=8787

# Public HTTPS only. localhost / RFC1918 / .local are invalid for a remote oracle source.
# DEMO_SOURCE_URL=

# --- Official-Close provider (G11 / `make oracle-e2e-devnet`; not used by `make demo`) ---
# MASSIVE_SIP_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# STOCK_API_KEY=

# --- Alerts (unattended operation is prohibited until these are configured and tested) ---
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_KEY_ID=
# ALERT_WEBHOOK_HMAC_SECRET_PATH=/run/secrets/meridian/alert-webhook-hmac
# ALERT_WEBHOOK_REPLAY_WINDOW_SECS=300

# --- Metadata (devnet creation; not required for localnet demo) ---
# ARWEAVE_UPLOADER_KEY_PATH=
# METADATA_GATEWAY_URL_1=
# METADATA_GATEWAY_URL_2=

# --- M6 Squads V4 (public identities, never private keys) ---
SQUADS_V4_PROGRAM_ID=SQDS4ep65T869zMMBKyuUq6aD6EgTu8psMjkvj52pCf
SQUADS_V4_AUDITED_COMMIT=64af7330413d5c85cbbccfd8c27a05d45b6e666f
SQUADS_V4_SDK_VERSION=2.1.4
