# Frontend public env (Next.js 14). Copy to `.env.local` (gitignored).
# These are inlined at **build** time — changing a value requires a rebuild
# (or a Vercel redeploy). The app is wallet UX only: it must never receive
# operator, governance, pause, override, or upgrade keys.
# See docs/GOVERNANCE.md.
#
# Defaults below are localnet (`make demo`). For Vercel / a public host,
# use the HTTPS values and see docs/DEPLOYMENT.md §3.

# Solana JSON-RPC the wallet-adapter uses.
NEXT_PUBLIC_RPC=http://127.0.0.1:8899
# Devnet / Vercel (HTTPS required when the site is HTTPS):
# NEXT_PUBLIC_RPC=https://api.devnet.solana.com

# Indexer JSON API (markets, book, portfolio, health).
NEXT_PUBLIC_INDEXER=http://127.0.0.1:8787
# Devnet / Vercel — public HTTPS indexer, not localhost:
# NEXT_PUBLIC_INDEXER=https://<your-indexer-host>

# Meridian program id (must match declare_id! / MERIDIAN_PROGRAM_ID).
NEXT_PUBLIC_MERIDIAN=HiREMEBWNojy6KJNbMbww2YkRJEYLGMgndaKwXndK6ZD
